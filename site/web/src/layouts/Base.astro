---
import '@fontsource-variable/bricolage-grotesque/opsz.css'
import '../styles/global.css'
import { createHash } from 'node:crypto'
import { readFileSync } from 'node:fs'
import { join } from 'node:path'

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
// versão do site.js pelo conteúdo: cada deploy muda o endereço e o navegador não usa o arquivo antigo do cache
const siteJsVersion = createHash('sha256')
  .update(readFileSync(join(process.cwd(), 'public', 'site.js')))
  .digest('hex')
  .slice(0, 10)
const ogImage = new URL('/shots/og.png', Astro.site)
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#0f0f13" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script is:inline type="module" src={`/site.js?v=${siteJsVersion}`}></script>
  </body>
</html>
