{
  "name": "arcanshot",
  "version": "0.1.0",
  "description": "Captura de tela com anotações no estilo Flameshot/Lightshot",
  "main": "./out/main/index.js",
  "author": "Vinicius Farias <farias.brz@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "gen:icon": "node scripts/gen-icon.mjs",
    "gen:pix": "node scripts/gen-pix.mjs",
    "dist": "npm run gen:icon && electron-vite build && electron-builder --win",
    "promo:narrate": "node scripts/promo/narrate.mjs",
    "promo:render": "node scripts/promo/render.mjs"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.1.0",
    "eslint": "^9.0.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^26.0.0",
    "qrcode": "1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "pdf-lib": "^1.17.1"
  }
}
